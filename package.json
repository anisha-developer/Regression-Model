{
  "name": "premiumiq",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "train": "python scripts/train_model.py",
    "dev": "concurrently -k -n api,web -c blue,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cross-env PYTHONPATH=. python -m uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm run dev --prefix frontend",
    "build:web": "npm run build --prefix frontend",
    "build": "npm run build:web",
    "vercel-build": "npm run build:web",
    "postinstall": "npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  }
}
