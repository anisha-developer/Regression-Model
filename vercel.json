{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend/dist",
  "build": {
    "env": {
      "UV_PYTHON": "3.12",
      "PYTHON_VERSION": "3.12"
    }
  },
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "entrypoint": ".",
      "framework": "vite",
      "routePrefix": "/"
    },
    "api": {
      "root": ".",
      "entrypoint": "backend/app/main.py",
      "framework": "fastapi",
      "routePrefix": "/api",
      "includeFiles": ["models/**"],
      "excludeFiles": [
        "frontend/**",
        "node_modules/**",
        "data/**",
        "docs/**",
        "scripts/**",
        "api/**",
        "*.ipynb",
        "medical_insurance_dataset.csv",
        "package-lock.json",
        "frontend/package-lock.json",
        "**/__pycache__/**",
        "**/tests/**",
        "**/test/**",
        "**/*.tests/**",
        "**/site-packages/**/tests/**",
        "**/site-packages/**/test/**"
      ],
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
