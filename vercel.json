{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend/dist",
  "build": {
    "env": {
      "UV_PYTHON": "3.12",
      "PYTHON_VERSION": "3.12"
    }
  },
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "entrypoint": ".",
      "framework": "vite",
      "routePrefix": "/"
    },
    "api": {
      "root": ".",
      "entrypoint": "backend/app/main.py",
      "framework": "fastapi",
      "routePrefix": "/api",
      "installCommand": "uv python pin 3.12 && uv sync --frozen --no-dev",
      "includeFiles": ["models/**", "data/**"],
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
