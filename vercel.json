{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "frontend": {
      "workspace": "frontend",
      "framework": "vite",
      "routePrefix": "/",
      "buildCommand": "npm ci && npm run build"
    },
    "api": {
      "workspace": ".",
      "entrypoint": "backend/app/main.py",
      "framework": "fastapi",
      "runtime": "python3.12",
      "routePrefix": "/api",
      "installCommand": "uv pip install --python 3.12 --system -r backend/requirements.txt",
      "includeFiles": ["models/**", "data/**"],
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
