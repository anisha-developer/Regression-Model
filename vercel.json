{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend/dist",
  "build": {
    "env": {
      "UV_PYTHON": "3.12",
      "PYTHON_VERSION": "3.12"
    }
  },
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "entrypoint": ".",
      "framework": "vite",
      "routePrefix": "/"
    },
    "api": {
      "root": "backend",
      "entrypoint": "app/main.py",
      "framework": "fastapi",
      "routePrefix": "/",
      "includeFiles": ["models/**"],
      "excludeFiles": [
        "frontend/**",
        "node_modules/**",
        "data/**",
        "docs/**",
        "scripts/**",
        "api/**",
        "*.ipynb",
        "medical_insurance_dataset.csv"
      ],
      "maxDuration": 60,
      "memory": 1024
    }
  }
}